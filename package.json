{
	"name": "fw-fanctrl-revived-gnome-shell-extension",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsup-node",
		"check": "prettier --check . && biome check . && tsc --noEmit",
		"fix": "prettier --write . && biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@girs/gjs": "5.2.0",
		"@girs/gnome-shell": "^50.0.4",
		"@types/node": "^25.9.7",
		"prettier": "^3.9.6",
		"tinyexec": "^1.3.1",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@12.4.2"
}
