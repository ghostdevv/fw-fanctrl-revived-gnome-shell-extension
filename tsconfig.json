{
	"compilerOptions": {
		"moduleResolution": "Bundler",
		"target": "ESNext",
		"module": "ESNext",
		"strict": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"checkJs": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node", "@girs/gjs", "@girs/gnome-shell"]
	},
	"include": ["src/**.ts", "src/**.js"],
	"exclude": ["node_modules/**", "dist/**"]
}
